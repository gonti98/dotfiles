font=FiraCode
anchor=top-right
margin=16
padding=12
border-size=2
border-radius=10
max-visible=5
max-history=10
default-timeout=5000
ignore-timeout=1

background-color=#1e1e2eff
text-color=#cdd6f4ff
border-color=#585b70ff
progress-color=over #89b4faff

[urgency=low]
background-color=#182a25ff
text-color=#a6e3a1ff
border-color=#40a02bff
default-timeout=3000

[urgency=normal]
background-color=#24243aff
text-color=#cdd6f4ff
border-color=#89b4faff
default-timeout=5000

[urgency=critical]
background-color=#4a1820ff
text-color=#f2cdcdff
border-color=#f38ba8ff
default-timeout=10000
