#!/usr/bin/env bash
set -euo pipefail

{{- if eq .chezmoi.osRelease.id "arch" }}

theme_dir="/usr/share/sddm/themes/sddm-astronaut-theme"
theme_url="https://github.com/keyitdev/sddm-astronaut-theme.git"

enable_sddm() {
  printf '\n%s\n' '--- Enabling SDDM display manager ---'
  if systemctl is-enabled sddm.service >/dev/null 2>&1; then
    printf '%s\n' 'sddm.service already enabled, skipping'
    return 0
  fi

  sudo systemctl enable sddm.service
  printf '%s\n' 'sddm.service enabled'
}

install_theme() {
  if [ -d "$theme_dir" ]; then
    printf 'Theme already installed at %s, skipping\n' "$theme_dir"
    return 0
  fi

  sudo git clone -q -b master --depth 1 "$theme_url" "$theme_dir"

  printf '%s\n' '--- Installing theme fonts ---'
  sudo cp -r "$theme_dir/Fonts/." /usr/share/fonts/
  sudo fc-cache -f >/dev/null

  printf '%s\n' '--- Configuring SDDM ---'
  sudo mkdir -p /etc/sddm.conf.d
  printf '[Theme]\nCurrent=sddm-astronaut-theme\n' |
    sudo tee /etc/sddm.conf.d/10-theme.conf >/dev/null
  printf '[General]\nInputMethod=qtvirtualkeyboard\n' |
    sudo tee /etc/sddm.conf.d/10-virtualkbd.conf >/dev/null

  printf '%s\n' 'SDDM astronaut theme installed.'
}

enable_sddm
install_theme

{{- else }}
{{ template "unsupported-distro" . }}
{{- end }}
